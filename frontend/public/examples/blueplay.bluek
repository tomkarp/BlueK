  "files": [
    {
      "fileName": "Dog.kt",
      "kind": "class",
      "source": "/** A simple dog that walks to the right. */\nclass Dog : Actor() {\n\n    init {\n        image = Image(\"dog.png\")\n    }\n\n    override fun act() {\n        move(1)\n    }\n}\n"
    },
    {
      "fileName": "MyWorld.kt",
      "kind": "class",
      "source": "/** A minimal world for the running dog. */\nclass MyWorld : World(600, 400, 1) {\n    init {\n        addObject(Dog(), 100, 200)\n    }\n}\n"
    },
    {
      "fileName": "Main.kt",
      "kind": "functions",
      "source": "/** Minimal BluePlay example. The Reset button runs this main() again. */\nfun main() {\n    val world = MyWorld()\n    world.show()\n}\n"
    }
  ],
