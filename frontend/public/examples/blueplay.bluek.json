      "source": "/** A simple figure that slowly walks to the right. */\nclass Figure : Actor() {\n\n    init {\n        setImage(\"figure.png\")\n    }\n\n    override fun act() {\n        move(1)\n    }\n}\n"
    },
    {
      "fileName": "MyWorld.kt",
      "kind": "class",
      "source": "/** A minimal world. It places a figure when it is created. */\nclass MyWorld : World(600, 400, 1) {\n    init {\n        addObject(Figure(), 100, 200)\n    }\n}\n"
    },
    {
      "fileName": "Main.kt",
      "kind": "functions",
      "source": "/** Minimal BluePlay example. The Reset button runs this main() again. */\nfun main() {\n    val world = MyWorld()\n    showWorld(world)\n}\n"
    }
