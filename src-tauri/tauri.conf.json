{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "BlueK",
  "version": "0.1.0",
  "identifier": "de.tomkarp.BlueK",
  "build": {
    "beforeDevCommand": "npm run dev -- --host 127.0.0.1",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "node scripts/build-desktop-frontend.mjs",
    "frontendDist": "../frontend/dist"
  },
  "app": {
    "windows": [
      {
        "title": "BlueK",
        "width": 1280,
        "height": 820,
        "minWidth": 900,
        "minHeight": 600
      }
    ],
    "security": {
      "csp": "default-src 'self' asset: http://asset.localhost; img-src 'self' asset: http://asset.localhost data: blob:; media-src 'self' asset: http://asset.localhost blob:; style-src 'self' 'unsafe-inline'; script-src 'self' 'unsafe-eval' 'wasm-unsafe-eval'; worker-src 'self' blob:; connect-src 'self' ipc: http://ipc.localhost asset: http://asset.localhost https://bluek.online https://api.bluek.online https://api-beta.bluek.online"
    }
  },
  "bundle": {
    "active": true,
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "category": "Education",
    "shortDescription": "Kotlin programming environment",
    "longDescription": "BlueK is a visual Kotlin programming environment for learning.",
    "fileAssociations": [
      {
        "ext": ["bluek"],
        "mimeType": "application/x-bluek-project",
        "name": "BlueK project",
        "role": "Editor",
        "description": "BlueK project file"
      }
    ],
    "macOS": {
      "minimumSystemVersion": "12.0"
    },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper" },
      "signCommand": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/sign-windows.ps1 %1"
    }
  }
}
