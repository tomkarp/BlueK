{
  "name": "bluek",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-offline.mjs --if-missing",
    "dev": "vite --config frontend/vite.config.ts",
    "dev:svelte": "npm run dev",
    "build:svelte": "vite build --config frontend/vite.config.ts",
    "build:kotlite": "./jvm/gradlew -p kotlite-browser jsBrowserProductionWebpack --no-daemon",
    "build:standard-images": "node scripts/build-standard-images.mjs",
    "build": "npm run build:kotlite && npm run build:offline && vite build --config frontend/vite.config.ts",
    "build:offline": "node scripts/build-offline.mjs",
    "browser-smoke": "node scripts/smoke-static-architecture.mjs && node scripts/smoke-svelte-architecture.mjs && node scripts/smoke-kotlite-browser.mjs && node scripts/smoke-blueplay-browser.mjs && node scripts/smoke-curriculum-kotlin.mjs && npm run test:runtime-state",
    "typecheck": "tsc && svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test:runtime-state": "node scripts/smoke-runtime-state.mjs",
    "test:references": "node scripts/smoke-references.mjs",
    "test:generics": "node scripts/smoke-generics.mjs && node scripts/smoke-generics-boundaries.mjs",
    "test:kotlin-surface": "node scripts/smoke-kotlin-surface.mjs",
    "test:offline": "node scripts/smoke-offline-build.mjs",
    "test:blueplay-demos": "node scripts/smoke-space-invaders.mjs",
    "test:ui": "node scripts/smoke-ui-behavior.mjs",
    "test:gui": "playwright test",
    "test:inspector": "node scripts/smoke-inspector-model.mjs",
    "test:project-format": "node scripts/smoke-project-format.mjs",
    "test:codepad-flow": "node scripts/smoke-codepad-flow.mjs",
    "share:server": "node server/share-server.mjs",
    "test:share-server": "node scripts/smoke-share-server.mjs",
    "test:regression": "npm run typecheck && npm run test:ui && npm run test:runtime-state && npm run test:references && npm run test:kotlin-surface && npm run test:inspector && npm run test:project-format && npm run test:codepad-flow && npm run test:offline && npm run test:gui"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3",
    "@replit/codemirror-vim": "^6.4.0",
    "@scalar/kotlin-fmt": "0.4.1",
    "better-sqlite3": "^12.11.1",
    "fflate": "^0.8.3",
    "vite": "8.2.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "22.20.2",
    "codemirror": "^6.0.2",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^3.0.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.0"
  }
}
