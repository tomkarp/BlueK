{
  "name": "bluek",
  "private": true,
  "type": "module",
  "scripts": {
    "predev": "node scripts/build-player.mjs --if-missing && node scripts/build-offline.mjs --if-missing",
    "dev": "vite --config frontend/vite.config.ts",
    "dev:svelte": "npm run dev",
    "build:svelte": "vite build --config frontend/vite.config.ts",
    "build:kotlite": "./jvm/gradlew -p kotlite-browser jsBrowserProductionWebpack --no-daemon && node scripts/build-blueplay-api.mjs",
    "build:standard-images": "node scripts/build-standard-images.mjs",
    "build": "npm run build:kotlite && npm run build:player && npm run build:offline && vite build --config frontend/vite.config.ts",
    "build:player": "node scripts/build-player.mjs",
    "build:offline": "node scripts/build-offline.mjs",
    "browser-smoke": "node scripts/smoke-static-architecture.mjs && node scripts/smoke-svelte-architecture.mjs && node scripts/smoke-kotlite-browser.mjs && node scripts/smoke-blueplay-api.mjs && node scripts/smoke-blueplay-browser.mjs && node scripts/smoke-curriculum-kotlin.mjs && npm run test:argument-diagnostics && npm run test:control-flow && npm run test:flow-state && npm run test:interfaces && npm run test:runtime-state",
    "typecheck": "tsc && svelte-check --tsconfig ./tsconfig.json --threshold error",
    "test:runtime-state": "node scripts/smoke-runtime-state.mjs",
    "test:debugger": "node scripts/smoke-debugger.mjs",
    "test:debugger:gui": "playwright test tests/gui/debugger.spec.ts",
    "test:references": "node scripts/smoke-references.mjs",
    "test:generics": "node scripts/smoke-generics.mjs && node scripts/smoke-generics-boundaries.mjs",
    "test:kotlin-surface": "node scripts/smoke-kotlin-surface.mjs",
    "test:argument-diagnostics": "node scripts/smoke-argument-diagnostics.mjs",
    "test:control-flow": "node scripts/smoke-control-flow.mjs",
    "test:control-flow:kotlin": "node scripts/compare-control-flow-kotlin.mjs",
    "test:flow-state": "node scripts/audit-flow-state.mjs",
    "test:flow-state:kotlin": "node scripts/audit-flow-state.mjs --reference",
    "test:performance": "node scripts/benchmark-interpreter.mjs",
    "test:conformance": "node scripts/conformance-kotlin.mjs",
    "test:offline": "node scripts/smoke-offline-build.mjs",
    "test:blueplay-demos": "node scripts/smoke-space-invaders.mjs",
    "test:ui": "node scripts/smoke-ui-behavior.mjs",
    "test:gui": "playwright test",
    "test:handoff": "playwright test tests/gui/project-handoff.spec.ts && playwright test tests/gui/project-handoff.spec.ts --browser=webkit",
    "test:inspector": "node scripts/smoke-inspector-model.mjs",
    "test:blueplay-stage": "node scripts/smoke-blueplay-stage.mjs",
    "test:project-format": "node scripts/smoke-project-format.mjs",
    "test:bluej-export": "node scripts/smoke-bluej-export.mjs",
    "test:program-export": "node scripts/smoke-program-export.mjs",
    "test:player-worker": "node scripts/smoke-player-worker.mjs",
    "test:codepad-flow": "node scripts/smoke-codepad-flow.mjs",
    "share:server": "node server/share-server.mjs",
    "test:share-server": "node scripts/smoke-share-server.mjs",
    "test:feedback-issue-body": "node tests/feedback-issue-body.mjs",
    "test:database-backup": "node scripts/smoke-database-backup.mjs",
    "test:regression": "npm run typecheck && npm run test:i18n && npm run test:ui && npm run test:publication-policy && npm run test:share-server && npm run test:window-interaction && npm run test:workspace && npm run test:runtime-state && npm run test:references && npm run test:testing && npm run test:kotlin-surface && npm run test:argument-diagnostics && npm run test:control-flow && npm run test:flow-state && npm run test:interfaces && npm run test:performance && npm run test:inspector && npm run test:blueplay-api && npm run test:blueplay-stage && npm run test:project-format && npm run test:bluej-export && npm run test:bluej-selection && npm run test:project-drafts && npm run test:program-export && npm run test:player-worker && npm run test:codepad-flow && npm run test:offline && npm run test:gui",
    "test:blueplay-api": "node scripts/smoke-blueplay-api.mjs",
    "test:window-interaction": "node scripts/smoke-window-interaction.mjs",
    "test:workspace": "node scripts/smoke-workspace-controllers.mjs",
    "test:testing": "node scripts/smoke-testing.mjs",
    "test:testing:portable": "node scripts/smoke-testing.mjs --jvm",
    "test:project-drafts": "node scripts/smoke-project-drafts.mjs",
    "test:i18n": "node scripts/smoke-i18n.mjs",
    "test:interfaces": "node scripts/audit-interfaces.mjs",
    "test:interfaces:kotlin": "node scripts/audit-interfaces.mjs --reference",
    "test:bluej-selection": "node scripts/smoke-bluej-selection.mjs",
    "test:publication-policy": "node scripts/smoke-publication-policy.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "^6.20.3",
    "@codemirror/commands": "^6.11.0",
    "@codemirror/language": "^6.12.4",
    "@codemirror/legacy-modes": "^6.5.4",
    "@codemirror/search": "^6.7.2",
    "@codemirror/state": "^6.7.4",
    "@codemirror/view": "^6.43.11",
    "@lezer/highlight": "^1.2.3",
    "@replit/codemirror-vim": "^6.4.0",
    "@scalar/kotlin-fmt": "0.4.1",
    "better-sqlite3": "^12.11.1",
    "fflate": "^0.8.3",
    "vite": "8.2.2"
  },
  "devDependencies": {
    "@playwright/test": "^1.63.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.0",
    "@types/node": "22.20.2",
    "codemirror": "^6.0.2",
    "prettier": "^3.0.0",
    "prettier-plugin-svelte": "^3.0.0",
    "svelte": "^5.57.0",
    "svelte-check": "^4.7.6",
    "typescript": "^6.0.0"
  }
}
